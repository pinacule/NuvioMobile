# Nuvio self-hosted sync backend — environment config.
#
# Copy to .env and fill in:
#   cp .env.example .env
# Fastest way to generate the secret values: python3 scripts/gen-keys.py > .env
# then edit NUVIO_BACKEND_URL below.

# Postgres superuser password (postgres role). Used by db, rest, auth, gateway.
POSTGRES_PASSWORD=change-me-before-first-run

# HS256 signing secret shared by PostgREST and GoTrue.
# Generated by scripts/gen-keys.py (32 random bytes, hex-encoded).
JWT_SECRET=change-me-before-first-run

# anon key: JWT {iss:"supabase", role:"anon"} signed with JWT_SECRET.
# Embedded in /.well-known/nuvio as publishable_key and handed to the app.
ANON_KEY=<from gen-keys.py>

# service_role key: JWT {iss:"supabase", role:"service_role"} signed with JWT_SECRET.
# Keep private. For your own admin use against /rest/v1 (bypasses RLS).
# The gateway authenticates to Postgres via DATABASE_URL instead.
SERVICE_ROLE_KEY=<from gen-keys.py>

# Public URL of this backend, as seen by the apps (no trailing slash).
# Used for GoTrue's SITE_URL and advertised in /.well-known/nuvio.
NUVIO_BACKEND_URL=https://sync.example.com
